# On Vercel, set the same variables under Project → Settings → Environment Variables,
# except the ones marked "local only".
# What each variable is for: docs/spec.md, sections "Env variables" and "Conversation log".

# --- Model access: Vercel AI Gateway -----------------------------------------
# Local only. On Vercel the deployment's OIDC token is used, so do not set it there.
# Get it: Vercel dashboard → AI Gateway → API Keys.
# Alternative: `vercel env pull .env` writes a short-lived OIDC token instead
# (it overwrites .env, so add the local-only values below again afterwards).
AI_GATEWAY_API_KEY=

# --- Meeting emails: Resend ---------------------------------------------------
# Local and Vercel. Get the key: resend.com → API Keys (the overeem.io domain must be verified).
RESEND_API_KEY=
# Where intro requests are sent: Gerwin's own address.
MEETING_RECIPIENT=
# Sender, on the verified overeem.io domain, e.g. cv-chat@overeem.io.
MEETING_FROM=

# --- Public contact details, shown in the footer -----------------------------
# Local and Vercel. The same email address as in the CV.
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_LINKEDIN_URL=

# --- Conversation log: LangSmith (EU region) ---------------------------------
# Local and Vercel. Get the key: eu.smith.langchain.com → Settings → API Keys.
# Locally, keep tracing off until the key is filled in; on Vercel it is true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=cv-chat

# --- CV conversion ------------------------------------------------------------
# LOCAL ONLY, never on Vercel. The real phone number, date of birth and home address,
# separated by |, so the PII guard can block them.
CV_PII_DENYLIST=

# --- Vercel bypass ------------------------------------------------------------
VERCEL_BYPASS=
